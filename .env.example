OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_DEFAULT_MODEL=
# TypeSafe System One (Jev) fast-path for intent routing / guide selection.
# Dialogue stays on OpenRouter; Jev only returns typed Choice/Noul decisions.
TYPESAFE_API_KEY=
# Optional overrides:
# TYPESAFE_ENABLED=1
# TYPESAFE_MODEL=jev-latest
# Decision providers, first usable answer wins (default: pplx via OpenRouter, Jev on error, then Mercury):
# TYPESAFE_PROVIDER_ORDER=pplx,jev,mercury
# PPLX_MODEL=perplexity/pplx-decider-v1.1-27b
# Fraction of pplx answers also sent to Jev in the background for comparison (0 disables):
# TYPESAFE_SHADOW_RATE=0.1
# TYPESAFE_SHADOW_LOG=logs/decision_shadow.jsonl
